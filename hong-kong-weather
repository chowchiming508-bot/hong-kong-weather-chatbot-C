<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hong Kong Weather Chatbot</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f8fb;
    }

    .chatbot {
      max-width: 420px;
      margin: auto;
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 10px #999;
    }

    .header {
      background: #1677b8;
      color: white;
      padding: 16px;
      font-size: 20px;
      font-weight: bold;
    }

    #messages {
      height: 280px;
      overflow-y: auto;
      padding: 12px;
    }

    .message {
      margin: 8px 0;
      padding: 10px;
      border-radius: 8px;
      line-height: 1.4;
    }

    .bot {
      background: #e8f1f7;
    }

    .user {
      background: #d5f5d5;
      text-align: right;
    }

    .controls {
      display: flex;
      border-top: 1px solid #ddd;
    }

    input {
      flex: 1;
      padding: 12px;
      border: 0;
      font-size: 15px;
    }

    button {
      padding: 12px;
      border: 0;
      background: #1677b8;
      color: white;
      cursor: pointer;
    }

    button:hover {
      background: #105b8c;
    }
  </style>
</head>
<body>
  <div class="chatbot">
    <div class="header">🌦️ Hong Kong Weather</div>

    <div id="messages">
      <div class="message bot">
        Hello! Ask me about the current weather in Hong Kong.
      </div>
    </div>

    <div class="controls">
      <input
        id="question"
        placeholder="e.g. What is the temperature?"
        onkeydown="if(event.key === 'Enter') askBot()"
      />
      <button onclick="askBot()">Send</button>
    </div>
  </div>

  <script>
    const latitude = 22.3193;
    const longitude = 114.1694;

    function addMessage(text, type) {
      const messages = document.getElementById("messages");
      const div = document.createElement("div");
      div.className = "message " + type;
      div.innerHTML = text;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    }

    function weatherDescription(code) {
      const descriptions = {
        0: "Clear sky",
        1: "Mainly clear",
        2: "Partly cloudy",
        3: "Overcast",
        45: "Foggy",
        48: "Rime fog",
        51: "Light drizzle",
        53: "Drizzle",
        55: "Heavy drizzle",
        61: "Light rain",
        63: "Rain",
        65: "Heavy rain",
        71: "Light snow",
        73: "Snow",
        75: "Heavy snow",
        80: "Rain showers",
        81: "Rain showers",
        82: "Heavy rain showers",
        95: "Thunderstorm"
      };
      return descriptions[code] || "Unknown conditions";
    }

    async function getWeather() {
      const url =
        `https://api.open-meteo.com/v1/forecast?latitude=${latitude}` +
        `&longitude=${longitude}` +
        `&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code` +
        `&timezone=Asia%2FHong_Kong`;

      const response = await fetch(url);
      if (!response.ok) throw new Error("Weather service unavailable");
      return response.json();
    }

    async function askBot() {
      const input = document.getElementById("question");
      const question = input.value.trim();

      if (!question) return;

      addMessage(question, "user");
      input.value = "";

      addMessage("Checking the latest Hong Kong weather...", "bot");

      try {
        const data = await getWeather();
        const weather = data.current;

        const temperature = weather.temperature_2m;
        const humidity = weather.relative_humidity_2m;
        const wind = weather.wind_speed_10m;
        const condition = weatherDescription(weather.weather_code);

        let feeling =
          temperature <= 20
            ? "It is cool."
            : temperature <= 26
            ? "It is fairly comfortable."
            : "It is warm or hot.";

        const answer = `
          <b>Hong Kong weather now:</b><br>
          🌡️ Temperature: ${temperature}°C<br>
          ☁️ Condition: ${condition}<br>
          💧 Humidity: ${humidity}%<br>
          💨 Wind: ${wind} km/h<br><br>
          <b>${feeling}</b>
        `;

        addMessage(answer, "bot");
      } catch (error) {
        addMessage(
          "Sorry, I could not retrieve the weather right now.",
          "bot"
        );
      }
    }
  </script>
</body>
</html>
